# Configurações de ambiente — backend truss-opt-3d
# Copie este arquivo para `.env` e ajuste conforme seu ambiente.

# Aplicação
NOME_APP=truss-opt-3d API
AMBIENTE=producao
DEPURAR=false
ORIGENS_CORS=*

# PostgreSQL
POSTGRES_USUARIO=truss
POSTGRES_SENHA=truss
POSTGRES_HOST=postgres
POSTGRES_PORTA=5432
POSTGRES_BANCO=truss_opt
ECHO_SQL=false

# Redis
REDIS_HOST=redis
REDIS_PORTA=6379
REDIS_DB=0

# Celery
CELERY_TEMPO_LIMITE_DURO=1800
CELERY_TEMPO_LIMITE_SUAVE=1500
CELERY_MAX_CONCORRENCIA=1

# Otimização
LIMITE_MEMORIA_PERCENTUAL=85.0

# Algoritmo Genético
AG_POPULACAO_TAMANHO=30
AG_GERACOES=25
AG_PROBABILIDADE_CRUZAMENTO=0.7
AG_PROBABILIDADE_MUTACAO=0.2
AG_INDICE_TORNEIO=3
AG_ALFA_CRUZAMENTO=0.5
AG_PROBABILIDADE_GAUSSIANA=0.5
AG_MU_MUTACAO=0.0
AG_SIGMA_MUTACAO=0.2
AG_PENALIDADE_VIOLACAO_NORMATIVA=1000000.0
AG_PENALIDADE_DIVERSIDADE_PERFIS=1000.0
AG_MAX_PERFIS_DISTINTOS=4

# Normas
NBR_FLECHA_LIMITE=250.0
NBR_ESBELTEZ_MAX_COMPRESSAO=200.0
NBR_ESBELTEZ_MAX_TRACAO=300.0
NBR_GAMMA_A1=1.10
NBR_CARGA_MANUTENCAO_KN=1.0
